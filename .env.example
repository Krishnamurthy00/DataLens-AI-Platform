# DataLens AI - Environment Configuration Example
# Copy this file to .env and configure your environment variables.

# Server settings
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# AI Provider Settings (Optional: If left blank or empty, DataLens AI automatically operates
# in Deterministic Verified Mode using local rule-based statistical synthesis)
AI_PROVIDER=deterministic # Options: "deterministic", "gemini", "openai"
GEMINI_API_KEY=
OPENAI_API_KEY=

# Data Processing Settings
MAX_UPLOAD_SIZE_MB=25
MAX_PREVIEW_ROWS=50
IQR_OUTLIER_THRESHOLD=1.5
